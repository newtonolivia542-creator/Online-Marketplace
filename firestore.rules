rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function unchangedExcept(resource, request, allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // Opposite of unchangedExcept: true as long as none of the given keys
    // are touched (everything else about the update is unrestricted by
    // this check). Used to wall off Stripe Connect status fields on a
    // user's own doc, which must only ever be written by a webhook via
    // the Admin SDK -- never by the seller themselves.
    function notTouching(resource, request, protectedKeys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys);
    }

    // Stripe Connect status stored on a seller's user doc. Only the Admin SDK
    // (createConnectOnboardingLink / the account.updated webhook) may ever
    // set these -- a user can neither write them later nor sign up with them
    // already filled in.
    function stripeConnectFields() {
      return [
        "stripeAccountId",
        "stripeChargesEnabled",
        "stripePayoutsEnabled",
        "stripeDetailsSubmitted",
        "stripeOnboardingStatus"
      ];
    }

    // A buyer may only review an order that's actually theirs, for the
    // product the review claims to be about, and only once it's been
    // delivered -- matching the "Leave Review" button, which only ever
    // appears on a delivered order. The order can be either a legacy
    // per-product order or one seller's sub-order of a newer checkout
    // (whose productIds lists every product it contained). exists() comes
    // first in each check so a review pointing at an order that isn't there
    // is simply denied rather than erroring.
    function canReviewLegacyOrder(orderId, productId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.productId == productId
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == "delivered";
    }

    function canReviewSellerOrder(orderId, productId) {
      return exists(/databases/$(database)/documents/sellerOrders/$(orderId))
        && get(/databases/$(database)/documents/sellerOrders/$(orderId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/sellerOrders/$(orderId)).data.fulfillmentStatus == "delivered"
        && productId in get(/databases/$(database)/documents/sellerOrders/$(orderId)).data.productIds;
    }

    function canReviewOrder(orderId, productId) {
      return canReviewLegacyOrder(orderId, productId)
        || canReviewSellerOrder(orderId, productId);
    }

    // =========================
    // USERS
    // =========================
    // - Anyone signed in may look up ONE specific user doc by id (needed so
    //   a seller can show a buyer's name on an order, etc.).
    // - Listing the WHOLE collection (admin.js's user table) is admin-only.
    // - A user may only create their OWN doc, and only with role "buyer" or
    //   "seller" -- "admin" can never be self-assigned.
    // - Signing up can't pre-fill any Stripe Connect status field (see
    //   stripeConnectFields above).
    // - A user may update their OWN doc but may never change their own
    //   role, and may never touch their own Stripe Connect status fields --
    //   those are only ever written by createConnectOnboardingLink / the
    //   account.updated webhook via the Admin SDK, which bypasses these
    //   rules entirely. A verified admin may update ONLY status/banReason on
    //   someone else's doc (ban/unban) -- nothing else, on nobody else's doc.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["buyer", "seller"]
        && !request.resource.data.keys().hasAny(stripeConnectFields());

      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && notTouching(resource, request, stripeConnectFields()))
        ||
        (isAdmin()
          && userId != request.auth.uid
          && unchangedExcept(resource, request, ["status", "banReason"]))
      );

      allow delete: if false;
    }

    // =========================
    // PRODUCTS
    // =========================
    // Public read (storefront is browsable while logged out). Only the
    // owning seller may create/update their own listings; sellerId can't
    // be reassigned on update. Owning seller or an admin may delete.
    match /products/{productId} {
      allow read: if true;

      // hiddenByPlan (hidden because the seller is over their plan's live-listing
      // limit) and promotedUntil (a paid promotion) are written only by Cloud
      // Functions. A seller can't create a listing already flagged, or edit
      // either field, so the limit and paid placement can't be skipped from the
      // browser.
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['hiddenByPlan', 'promotedUntil'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "seller";

      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenByPlan', 'promotedUntil']);

      allow delete: if isSignedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // =========================
    // ORDERS
    // =========================
    // Orders are only ever created by the verifyPayment Cloud Function
    // (Admin SDK, bypasses these rules entirely) -- clients can never
    // create one, so deliveryAddress/orderNumber set there can't be forged
    // or altered afterward either. Buyer, seller, or admin may read -- this
    // is also what scopes a multi-seller checkout's delivery address to
    // only the seller(s) who actually have an order for it, since each
    // seller's line item is its own document. The owning seller may update
    // ONLY status/shippedAt/deliveredAt/trackingNumber, and only while
    // moving the order to (or already at) "shipped" or "delivered" -- price,
    // quantity, buyer, address, and "paid" status can't be touched from the
    // client.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && unchangedExcept(resource, request, ["status", "shippedAt", "deliveredAt", "trackingNumber"])
        && request.resource.data.status in ["shipped", "delivered"];

      allow delete: if false;
    }

    // =========================
    // SELLER SUB-ORDERS (Stripe Connect checkout -- one per seller per checkout)
    // =========================
    // Created only by verifyPayment via the Admin SDK, which bypasses
    // these rules -- clients can never create one, so chargeType,
    // commissionRate/commissionAmountCents, taxCents/taxLiabilityAtPurchase,
    // transfer/refund/dispute/payout state can't be forged or altered from
    // the client. Buyer, the owning seller, or an admin may read. The
    // owning seller may update ONLY fulfillmentStatus/shippedAt/
    // deliveredAt/trackingNumber, and only while moving to "shipped" or
    // "delivered" -- exactly the same shape as the legacy per-product
    // orders rule below, just on the new per-seller document.
    match /sellerOrders/{sellerOrderId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if false;

      // returnAddress is where the buyer should send a return; the seller
      // enters it when shipping. Every return/refund field (activeReturnId,
      // returnStatus, refunds) and the server-stamped shippedAtServer /
      // deliveredAtServer are deliberately NOT in this list, so a seller can't
      // touch them -- the return window depends on those two times.
      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && unchangedExcept(resource, request, ["fulfillmentStatus", "shippedAt", "deliveredAt", "trackingNumber", "returnAddress"])
        && request.resource.data.fulfillmentStatus in ["shipped", "delivered"]
        // Once an order was cancelled or returned (set by the server), the
        // seller can't move it back to shipped/delivered.
        && resource.data.fulfillmentStatus in ["paid", "shipped", "delivered"]
        && (!("returnAddress" in request.resource.data) || request.resource.data.returnAddress == null || request.resource.data.returnAddress is map);

      allow delete: if false;
    }

    // =========================
    // RETURNS AND CANCELLATIONS
    // =========================
    // Written only by the return Cloud Functions (Admin SDK), which decide who
    // may do what, check the return window and send the refund. The buyer, the
    // seller of the order, and admins can read; nobody can write from a client.
    match /returns/{returnId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      allow create, update, delete: if false;
    }

    // =========================
    // CHECKOUT ORDERS (one buyer-facing parent order per checkout)
    // =========================
    // Created only by verifyPayment via the Admin SDK. The buyer or an
    // admin may read it; sellers read their own slice of a checkout via
    // sellerOrders instead. Never client-writable -- there is nothing on
    // this document a client should ever be able to change.
    match /checkoutOrders/{checkoutId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );

      allow create, update, delete: if false;
    }

    // =========================
    // STRIPE WEBHOOK EVENTS (idempotency log)
    // =========================
    // Written and read exclusively by the webhook Cloud Function via the
    // Admin SDK -- clients never touch this directly.
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // =========================
    // PLATFORM CONFIG (e.g. the tax-liability setting)
    // =========================
    // Admin-SDK only, never client-readable or writable. Holds
    // config/platformSettings.taxLiability -- until that's explicitly set
    // to "platform" or "connectedAccount" by an operator (never by a
    // client), Cloud Functions treat it as unresolved and behave
    // accordingly (see getTaxLiability / assertTaxLiabilityAllowsCheckout
    // in functions/index.js).
    match /config/{configId} {
      allow read, write: if false;
    }

    // =========================
    // ACCOUNT RECOVERY (the phone number a seller keeps for password recovery)
    // =========================
    // Written ONLY by the recovery Cloud Functions, after the number has been
    // verified by a texted code. The owner can read their own record (so the
    // page can show "recovery phone ending in 0123"); nobody else can, and no
    // client can write or list it. Deliberately NOT part of the users
    // document, which every signed-in user can read.
    match /accountRecovery/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // =========================
    // SELLER PLANS (subscription state)
    // =========================
    // Written only by Cloud Functions from Stripe's webhooks. A seller can read
    // their own plan (so the plan page can show it) but nobody can write it or
    // list everyone's -- a plan can't be granted from the browser.
    match /sellerPlans/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Promoted listings: one record per promotion, the free ones used each month,
    // and which "ending soon" reminders were sent. Cloud Functions only -- a
    // promotion can't be granted, extended or read from the browser.
    match /promotions/{id} {
      allow read, write: if false;
    }

    match /promotionUsage/{id} {
      allow read, write: if false;
    }

    match /promotionNotices/{id} {
      allow read, write: if false;
    }

    // Partner banners (advertising). partnerSpots is the public part -- the image,
    // link, dates and placements the public pages need -- so anyone may read it,
    // but only Cloud Functions write it. The advertiser's email, price, notes and
    // invoice, the view/click counts, and the rate-limit counters are server-only.
    match /partnerSpots/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /partnerSpotsPrivate/{id} {
      allow read, write: if false;
    }

    match /partnerStats/{id} {
      allow read, write: if false;
    }

    match /partnerLimits/{id} {
      allow read, write: if false;
    }

    // Seller Insights: the subscription, the AI summaries used each month, and the
    // last AI summary. Cloud Functions only; the page reads through endpoints.
    match /sellerInsights/{uid} {
      allow read, write: if false;
    }

    match /insightsUsage/{id} {
      allow read, write: if false;
    }

    match /insightsReports/{uid} {
      allow read, write: if false;
    }

    // Marks which "your free listings are changing" reminders were already
    // sent. Cloud Functions only.
    match /planNotices/{key} {
      allow read, write: if false;
    }

    // =========================
    // PUBLIC CONFIG (return policy numbers, plan prices and limits)
    // =========================
    // publicConfig/returnPolicy holds the return/cancellation policy numbers
    // (return window, days to ship a return back, ...). Anyone may read it so
    // the app can show the same dates the server enforces; nobody can write it
    // from a client -- it's edited in the Firebase console / Admin SDK.
    match /publicConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // ORDER NUMBER COUNTER
    // =========================
    // A single counter document incremented inside the verifyPayment
    // transaction to hand out sequential, human-readable order numbers.
    // Admin SDK only -- clients never read or write it directly.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // =========================
    // PENDING ORDERS (checkout staging)
    // =========================
    // Written and read exclusively by Cloud Functions via the Admin SDK,
    // which bypasses rules entirely -- clients never touch this directly.
    match /pendingOrders/{orderId} {
      allow read, write: if false;
    }

    // =========================
    // EMAIL RATE LIMITS (verification / password reset cooldowns)
    // =========================
    // Written and read exclusively by Cloud Functions via the Admin SDK,
    // which bypasses rules entirely -- clients never touch this directly.
    match /emailRateLimits/{key} {
      allow read, write: if false;
    }

    // =========================
    // CARTS
    // =========================
    match /carts/{cartId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // =========================
    // MESSAGES
    // =========================
    // Only the sender/receiver of a message may ever read it. Senders may
    // only create as themselves. The only allowed update is appending to
    // "deletedBy" (soft delete) by a participant.
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );

      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;

      allow update: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid)
        && unchangedExcept(resource, request, ["deletedBy"]);

      allow delete: if false;
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    // Any signed-in user may create a notification FOR another user (this
    // is how "you got a message/order/review" notifications work) -- but
    // only the notification's owner may ever read, mark-read, or delete it.
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // =========================
    // REVIEWS
    // =========================
    // Public read (shown on product pages to logged-out visitors too).
    // Create requires proof of a real, delivered purchase (canReviewOrder
    // above) -- a buyer can no longer post a review for a product they
    // never bought just by guessing a productId. Only the authoring buyer
    // may create/edit/delete their own review; photos ride along as a
    // "photos" array on the same document, no separate rule needed for
    // them at the Firestore layer (Storage has its own rule for the actual
    // image files).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.orderId is string
        && canReviewOrder(request.resource.data.orderId, request.resource.data.productId);

      allow update, delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
    }

    // Deny anything not explicitly handled above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
